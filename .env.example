# Public site origin — used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://buymeatee.com

# Early-access form submission endpoint (server-side only, never exposed to the browser).
# Point this at any service accepting a JSON POST (Formspree, Loops, ConvertKit,
# a Supabase function, …). Leave empty to show an honest "not connected yet" state.
EARLY_ACCESS_API_URL=

# ---------------------------------------------------------------------------
# Supabase (project ref hjpfycbamwwpemsrrsqy — ADR-008)
# ---------------------------------------------------------------------------
# URL + anon key are public by design (RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side ONLY. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (ADR-009). NEVER commit real keys. Test and live use different keys
# AND different webhook signing secrets — configure them per environment.
# ---------------------------------------------------------------------------
# Publishable key (browser-safe). Not currently required — Stripe-hosted
# Checkout works via server-created session URLs — reserved for embedded flows.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (sk_test_… / sk_live_…): trusted server code only.
STRIPE_SECRET_KEY=
# Signing secret of THIS environment's webhook endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=

# Connect + Checkout URLs. Optional — they default to NEXT_PUBLIC_SITE_URL
# paths shown below and must stay on that origin (open-redirect protection).
# {GIFT_PUBLIC_ID} is substituted per checkout.
STRIPE_CONNECT_RETURN_URL=
# default: https://buymeatee.com/settings/payments/return
STRIPE_CONNECT_REFRESH_URL=
# default: https://buymeatee.com/api/connect/refresh
STRIPE_CHECKOUT_SUCCESS_URL=
# default: https://buymeatee.com/gifts/{GIFT_PUBLIC_ID}/thanks
STRIPE_CHECKOUT_CANCEL_URL=
# default: https://buymeatee.com/gifts/{GIFT_PUBLIC_ID}/cancelled

# Fee model (documented commercial assumptions — lib/payments/config.ts).
# Platform fee in basis points of the gift (500 = 5%).
STRIPE_PLATFORM_FEE_BPS=500
# Assumed card-processing percentage (decimal, max 2 places; "1.5" = 1.5%).
STRIPE_PAYMENT_FEE_PERCENT=1.5
# Per-currency amounts are optional overrides — sensible defaults live in
# lib/payments/config.ts for every supported currency (gbp, eur, usd, cad,
# aud, nzd, chf, sek, nok, dkk). Set STRIPE_<NAME>_<CUR> to override one.
# Assumed fixed processing fee per payment, integer minor units.
STRIPE_PAYMENT_FEE_FIXED_GBP=20
STRIPE_PAYMENT_FEE_FIXED_EUR=25
# Gift bounds, integer minor units (100 = £1.00 / €1.00).
STRIPE_MINIMUM_GIFT_GBP=100
STRIPE_MINIMUM_GIFT_EUR=100
STRIPE_MAXIMUM_GIFT_GBP=50000
STRIPE_MAXIMUM_GIFT_EUR=50000
# Countries recipients may onboard from (ISO alpha-2, comma-separated).
# Defaults to the full supported set (lib/payments/countries.ts) when unset;
# narrow it to what your platform Stripe account supports cross-border Connect
# for. Every code here must be in that table.
STRIPE_CONNECT_ALLOWED_COUNTRIES=GB,US,CA,AU,NZ,IE,DE,FR,ES,IT,NL,BE,AT,PT,FI,CH,SE,NO,DK

# Optional bearer token letting a scheduler call POST /api/admin/reconcile.
RECONCILIATION_SECRET=

# ---------------------------------------------------------------------------
# Email (Resend — ADR-013). Transactional platform emails: gift received,
# gift receipt, early-access welcome, goal reached. Fails safely — with no key
# or sender configured, sends report "not-configured" and nothing is faked.
# NOTE: magic-link SIGN-IN emails are sent by Supabase Auth, not this app.
# Route those through Resend via Supabase → Auth → SMTP (see docs/email-setup.md).
# ---------------------------------------------------------------------------
# API key (re_...): trusted server code only. Never commit a real key.
RESEND_API_KEY=
# Verified sender in RFC 5322 form; its domain must be verified in Resend.
EMAIL_FROM=BuyMeATee <notifications@buymeatee.com>
# Optional Reply-To; defaults to EMAIL_FROM when empty.
EMAIL_REPLY_TO=
# Optional bearer token letting a scheduler call POST /api/notifications/deliver
# to drain the pending notification queue (gift received, goal reached).
NOTIFICATIONS_DELIVERY_SECRET=

# ---------------------------------------------------------------------------
# AI share-copy personalisation (ADR-022) — OPTIONAL.
# When unset, share moments show the translated template copy only and the
# "Personalise with AI" button reports itself unavailable (fail-safe).
# ---------------------------------------------------------------------------
# OpenAI API key (sk-...): trusted server code only. Never commit a real key.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini.
SHARE_AI_MODEL=

# ---------------------------------------------------------------------------
# Merchandise shops (Printful print-on-demand — ADR-024). Staged rollout:
# EVERY flag below defaults to OFF so nothing merch is live until explicitly
# enabled, one stage at a time. Merch is separate from contributions.
# ---------------------------------------------------------------------------
# Global merchandise kill switch. Nothing merch is available while false.
MERCH_ENABLED=false
# Gate product creation to invited beta creators.
MERCH_CREATOR_BETA_ENABLED=false
# Allow supporters to actually pay for merchandise. Requires compliance sign-off.
MERCH_CHECKOUT_ENABLED=false
# Allow automatic Printful order submission after a paid order (else manual).
PRINTFUL_ORDER_SUBMISSION_ENABLED=false
# Allow automatic creator-profit transfers (else transfers are admin-triggered).
MERCH_AUTOMATIC_CREATOR_TRANSFERS_ENABLED=false
# Records that the seller-of-record / VAT / sales-tax / OSS decision has been
# made (spec §23). A technical guardrail, NOT legal advice. Live checkout is
# refused until this is true.
MERCH_COMPLIANCE_APPROVED=false
# When creator profit is transferred: manual | on_printful_confirmation |
# on_fulfilment_started | on_first_shipment (default). Shipping/tax are never
# creator earnings — only creator_profit is ever transferred.
MERCH_CREATOR_TRANSFER_RELEASE_POLICY=on_first_shipment

# Merch platform fee, basis points of the creator's PRE-FEE margin (1000 = 10%).
MERCH_PLATFORM_FEE_BASIS_POINTS=1000
# Optional per-currency floors, integer minor units (e.g. _GBP, _EUR, _USD…).
# MERCH_MINIMUM_PLATFORM_FEE_GBP=0
# A product must clear this creator profit to be published/sold (minor units).
# MERCH_MINIMUM_CREATOR_PROFIT_GBP=100

# ---------------------------------------------------------------------------
# Printful API (server-side only — never exposed to the browser). Until these
# are set, all Printful calls fail safely and no live orders can be created.
# ---------------------------------------------------------------------------
# Printful API token (Bearer). Trusted server code only. Never commit a real one.
PRINTFUL_API_TOKEN=
# Printful store id (for account-level / OAuth tokens that serve multiple stores).
PRINTFUL_STORE_ID=
# Override the Printful API base URL (defaults to the current stable endpoint).
PRINTFUL_API_BASE_URL=
# Secret used to verify inbound Printful webhooks / secure the webhook URL.
PRINTFUL_WEBHOOK_SECRET=
# draft | auto — create Printful orders as drafts (manual confirm) or auto-confirm.
PRINTFUL_ORDER_MODE=draft
